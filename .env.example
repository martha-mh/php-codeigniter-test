# ============================================
# CONFIGURACIÓN DE ENTORNO - EJEMPLO
# ============================================
# Copia este archivo como .env y ajusta los valores según tu entorno

# ============================================
# Base de Datos
# ============================================
DB_HOSTNAME=db
DB_USERNAME=ci_user
DB_PASSWORD=cipass
DB_DATABASE=ci_db
DB_DRIVER=mysqli

# ============================================
# Docker MySQL
# ============================================
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=ci_db
MYSQL_USER=ci_user
MYSQL_PASSWORD=cipass

# ============================================
# Entorno de la aplicación
# ============================================
CI_ENVIRONMENT=development
# Valores: development, testing, production

# ============================================
# URLs
# ============================================
BASE_URL=http://localhost:8080

# ============================================
# Notas de Seguridad
# ============================================
# - NUNCA subas el archivo .env al repositorio
# - Cambia las contraseñas en producción
# - Usa contraseñas seguras y únicas
# - Para producción, usa variables de entorno del servidor
